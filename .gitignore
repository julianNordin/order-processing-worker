# Build output. Both directories are regenerated by `dotnet build` and neither is reproducible
# across machines, so nothing in them belongs in history.
bin/
obj/

# Test and coverage artefacts. These are listed here before the first test run rather than after,
# because the reports are stuffed with absolute paths and timestamps from the machine that produced
# them - exactly the sort of thing that is tedious to remove once committed.
TestResults/
coverage/
*.coverage
*.coveragexml

# Local configuration. `.env` holds the broker and database credentials for a developer's own
# machine; `.env.example` is committed in its place and is the file the README tells you to copy.
.env

# Editor and tooling state.
.vs/
.idea/
*.user
*.suo
