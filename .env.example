# Copy to .env before running anything: `cp .env.example .env`
#
# .env is gitignored. These are local development credentials and nothing else - the deployed
# system takes its configuration from the environment, and no connection string or password is ever
# committed to this repository.

RABBITMQ_USER=orderprocessing
RABBITMQ_PASSWORD=local-development-only

POSTGRES_USER=orderprocessing
POSTGRES_PASSWORD=local-development-only
